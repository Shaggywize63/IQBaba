# Copy to .env and fill in. NEVER commit the real file — this repository is
# public, and on shared hosting the repository is also what the web server
# serves, so a committed .env is readable two different ways.
#
# On Hostinger, prefer hPanel's environment variables (hPanel > Advanced >
# Node.js > Environment variables) over a file on disk.

PORT=5001
NODE_ENV=production

# Leave empty when the app is served from the domain root.
BASE_PATH=

# Hostinger names these like u123456_iqbaba — not root/olympiad_db, which is
# only right for a local machine.
DB_HOST=127.0.0.1
DB_USER=
DB_PASSWORD=
DB_NAME=

# Any long random string. Changing it signs every user out, which is exactly
# what you want after the old one has been exposed.
JWT_SECRET=

# Used once, on first startup, to create an admin when none exists.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
