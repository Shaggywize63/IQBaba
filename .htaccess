# The web server publishes this repository directly, so everything here is a
# URL unless it is denied. These rules keep server-side files off the web.
#
# LiteSpeed (Hostinger) and Apache both honour this file. It does not apply
# when a request is handled by the Node app instead.

# Dotfiles: .env, .git, .gitignore ...
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Belt and braces for the one that matters most.
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

# Server-side sources, dumps and scripts. The site is the HTML, CSS, JS and
# media at the top level; nothing below needs to be fetchable.
<FilesMatch "\.(sql|sql\.gz|sh|log|md|yml|yaml|lock)$">
    Require all denied
</FilesMatch>

RedirectMatch 404 ^/\.git(/|$)
RedirectMatch 404 ^/backend(/|$)
RedirectMatch 404 ^/node_modules(/|$)
RedirectMatch 404 ^/backups(/|$)

# Directory listings would otherwise expose the layout.
Options -Indexes
